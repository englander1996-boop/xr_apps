# =========================================================
# xr_apps workspace .gitignore
# =========================================================

# --- Dependencies ---------------------------------------------------
node_modules/
package-lock.json

# --- Build output ---------------------------------------------------
dist/
.vite/
*.ehpk
out.ehpk

# --- even-dev (OSS clone, managed separately) -----------------------
# even-dev はこの repo の対象外。新マシンに移すときは別途 clone する。
# even-dev/apps.json (user の編集物) は欲しければ手動でバックアップしておくこと。
/even-dev/

# --- Per-app caches -------------------------------------------------
.apps-cache/

# --- OS ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- Logs ----------------------------------------------------------
npm-debug.log*
*.log

# --- Env / secrets (念のため) --------------------------------------
.env
.env.local
*.pem
