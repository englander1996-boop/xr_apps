# テキストファイル全般は LF に統一 (TS / JSON / MD / HTML / CSS 等)
* text=auto eol=lf

# Windows ネイティブなスクリプトは CRLF
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# バイナリは触らない
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ehpk  binary
*.zip   binary
